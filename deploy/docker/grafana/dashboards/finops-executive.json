{
  "dashboard": {
    "id": null,
    "title": "FinOps - Executive Overview",
    "tags": ["finops", "executive"],
    "timezone": "browser",
    "schemaVersion": 36,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Total Cost (30d)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(cost_total{period="30d"})",
            "legendFormat": "Total Cost"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Forecast (30d)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(forecast_total{period="30d"})",
            "legendFormat": "Forecast"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Potential Savings",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(recommendation_savings{status="open"})",
            "legendFormat": "Savings"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Budget Utilization",
        "type": "gauge",
        "targets": [
          {
            "expr": "avg(budget_utilization_ratio)",
            "legendFormat": "Utilization"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Cost Trend",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(cost_total[1d])) by (provider)",
            "legendFormat": "{{provider}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 6,
        "title": "Cost by Service",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(cost_total) by (service_name)",
            "legendFormat": "{{service_name}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 7,
        "title": "Anomalies",
        "type": "table",
        "targets": [
          {
            "expr": "anomaly_count{severity=~"critical|high"}",
            "format": "table"
          }
        ],
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 12}
      }
    ]
  },
  "overwrite": true
}