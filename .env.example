# FinOps Enterprise Platform - Environment Variables

# ==========================================
# Infrastructure
# ==========================================
POSTGRES_DSN=postgres://finops:finops@postgres:5432/finops?sslmode=disable
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DB=finops
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:9092

# ==========================================
# Security
# ==========================================
JWT_SECRET=finops-enterprise-secret-key-change-in-production
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# ==========================================
# Currency Conversion
# ==========================================
USD_TO_BRL_RATE=5.15

# ==========================================
# Frontend
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8080

# ==========================================
# Huawei OBS (MANDATÓRIO)
# O ingestion-service falha sem essas credenciais.
# A OBS é acessada via cliente S3 compatível.
# ==========================================
HUAWEI_ACCESS_KEY=
HUAWEI_SECRET_KEY=
HUAWEI_OBS_ENDPOINT=obs.sa-brazil-1.myhuaweicloud.com

# ==========================================
# Alert Channels (preencher para notificações)
# ==========================================
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=finops@company.com

# ==========================================
# Observability
# ==========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=30d

# ==========================================
# ML Configuration
# ==========================================
FORECAST_DEFAULT_MODEL=ensemble
FORECAST_CONFIDENCE=0.85
ANOMALY_SENSITIVITY=0.05
ANOMALY_WINDOW=7
